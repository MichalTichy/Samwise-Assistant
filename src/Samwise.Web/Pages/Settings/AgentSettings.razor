@inherits AppComponentBase
@page "/agent-settings"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Agent settings · Samwise</PageTitle>

@if (ActionError is not null)
{
    <div class="inline-alert" role="alert">@ActionError</div>
}

<div class="page-heading-row">
    <div>
        <span class="page-kicker">Configuration</span>
        <h1>Agent settings</h1>
        <p>Choose the model, reasoning effort, and instructions Samwise uses at each stage.</p>
    </div>
</div>

@if (configurations.Count > 0 && selected is not null)
{
    <div class="prompt-layout">
        <aside class="prompt-tabs">
            @foreach (var configuration in configurations)
            {
                <LumexButton FullWidth="true"
                             Variant="@Variant.Light"
                             Color="@ThemeColor.Primary"
                             Class="@($"prompt-tab {(configuration.Stage == selected.Stage ? "active" : null)}")"
                             OnClick="() => SelectAsync(configuration)">
                    <strong>@configuration.Name</strong>
                    <span>@DescribeStage(configuration.Stage)</span>
                </LumexButton>
            }
        </aside>

        <LumexCard Class="prompt-editor-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
        <LumexCardBody Class="prompt-editor-body">
            <div class="prompt-editor-heading">
                <div>
                    <h2>@selected.Name agent</h2>
                    <p>Runtime settings and prompt changes apply to the next invocation.</p>
                </div>
                <span class="save-state">@saveMessage</span>
            </div>

            <div class="agent-runtime-settings">
                <label>
                    <span>Model</span>
                    <select class="configuration-input"
                            value="@model"
                            @onchange="ModelChanged"
                            disabled="@(availableModels.Count == 0)">
                        @if (!string.IsNullOrWhiteSpace(model) &&
                             availableModels.All(candidate => candidate.Id != model))
                        {
                            <option value="@model">@model (unavailable)</option>
                        }
                        @foreach (var availableModel in availableModels)
                        {
                            <option value="@availableModel.Id">@availableModel.Id</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Reasoning effort</span>
                    <select class="configuration-input"
                            @bind="reasoningEffort"
                            disabled="@(availableReasoningEfforts.Count == 0)">
                        @if (!string.IsNullOrWhiteSpace(reasoningEffort) &&
                             !availableReasoningEfforts.Contains(reasoningEffort, StringComparer.Ordinal))
                        {
                            <option value="@reasoningEffort">@FormatEffort(reasoningEffort) (unavailable)</option>
                        }
                        @foreach (var effort in availableReasoningEfforts)
                        {
                            <option value="@effort">@FormatEffort(effort)</option>
                        }
                    </select>
                </label>
            </div>

            @if (loadingModels)
            {
                <LoadingSkeleton Label="Loading model options" Rows="2" />
            }
            else if (availableModels.Count == 0)
            {
                <div class="inline-alert">
                    @(SelectedModelCatalogError ?? "The Gateway did not report any models for this stage.")
                </div>
            }

            <section class="stage-tool-catalog">
                <div class="stage-tool-catalog-heading">
                    <div>
                        <strong>Available MCP servers and tools</strong>
                        <span>Capabilities granted to this stage's Gateway profile.</span>
                    </div>
                    @if (SelectedToolCatalog is { } headingCatalog)
                    {
                        <span title="@headingCatalog.CatalogVersion">
                            @headingCatalog.Servers.Count servers · @headingCatalog.Tools.Count tools · @FormatCatalogVersion(headingCatalog.CatalogVersion)
                        </span>
                    }
                </div>

                @if (SelectedToolCatalogError is { } toolError)
                {
                    <div class="inline-alert">@toolError</div>
                }
                else if (loadingTools)
                {
                    <LoadingSkeleton Label="Loading Gateway MCP tools" Rows="3" />
                }
                else if (SelectedToolCatalog is not { } toolCatalog)
                {
                    <p class="stage-tool-empty">The Gateway MCP catalog is unavailable.</p>
                }
                else if (toolCatalog.Servers.Count == 0)
                {
                    <p class="stage-tool-empty">No MCP servers or tools are granted to this stage.</p>
                }
                else
                {
                    <div class="stage-tool-servers">
                        @foreach (var server in toolCatalog.Servers.OrderBy(server => ServerTitle(server), StringComparer.OrdinalIgnoreCase))
                        {
                            <details class="stage-tool-server">
                                <summary>
                                    <span>
                                        <strong>@ServerTitle(server)</strong>
                                        <code>@server.Id</code>
                                    </span>
                                    <span>
                                        @if (!string.IsNullOrWhiteSpace(server.Version))
                                        {
                                            <small>v@server.Version</small>
                                        }
                                        @if (server.Required)
                                        {
                                            <small>Required</small>
                                        }
                                        <small>@server.Tools.Count tools</small>
                                    </span>
                                </summary>
                                @if (!string.IsNullOrWhiteSpace(server.Description))
                                {
                                    <p>@server.Description</p>
                                }
                                <div class="stage-tool-list">
                                    @foreach (var tool in server.Tools.OrderBy(tool => tool.Name, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <article>
                                            <div>
                                                <strong>@tool.Name</strong>
                                                <code>@tool.Id</code>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(tool.Description))
                                            {
                                                <p>@tool.Description</p>
                                            }
                                        </article>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }

                @if (selected.Stage == AgentStage.Intake)
                {
                    <p class="stage-tool-note">
                        Intake can also receive the Planning and Execution catalogs as
                        <code>{{planning_tools}}</code> and <code>{{execution_tools}}</code> prompt data.
                    </p>
                }
                else if (selected.Stage == AgentStage.AutomaticApproval)
                {
                    <p class="stage-tool-note">This profile must have no MCP tool grants. Samwise checks its catalogue before asking the agent to approve a plan.</p>
                }
                else if (selected.Stage == AgentStage.AutoApprovedExecution)
                {
                    <p class="stage-tool-note">Only tools granted here can be used after automatic approval. Planned tool calls must also exist in this catalogue.</p>
                }
            </section>

            <div class="configuration-field-heading">
                <strong>Prompt</strong>
                <span>Use only placeholders from the legend below.</span>
            </div>
            <LumexTextarea Class="prompt-textarea"
                           MinRows="18"
                           MaxRows="30"
                           Behavior="@InputBehavior.OnInput"
                           Variant="@InputVariant.Outlined"
                           @bind-Value="content" />

            @if (errors.Count > 0)
            {
                <div class="inline-alert">
                    @foreach (var error in errors)
                    {
                        <div>@error</div>
                    }
                </div>
            }

            <div class="prompt-actions">
                <span>Changes apply to the next run.</span>
                <ActionButton Color="@ThemeColor.Primary"
                             Variant="@Variant.Shadow"
                             OnClick="SaveAsync"
                             Disabled="@(IsActionRunning || saving || availableModels.Count == 0)">
                    @(saving ? "Saving…" : "Save agent settings")
                </ActionButton>
            </div>

            <div class="placeholder-legend">
                <h3>Placeholder legend</h3>
                <div class="placeholder-grid">
                    @foreach (var placeholder in selected.Placeholders)
                    {
                        <article>
                            <code>@($"{{{{{placeholder.Key}}}}}")</code>
                            <strong>@placeholder.Label</strong>
                            <p>@placeholder.Description</p>
                        </article>
                    }
                </div>
            </div>
        </LumexCardBody>
        </LumexCard>
    </div>
}
else if (LoadError is not null)
{
    <div class="inline-alert" role="alert">@LoadError</div>
}
else if (IsLoading)
{
    <LoadingSkeleton Label="Loading agent settings" Rows="6" />
}
else
{
    <div class="empty-state">Agent settings are unavailable.</div>
}
