@page "/settings/password"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Change password · Samwise</PageTitle>

<div class="settings-page">
    <div class="settings-heading">
        <span class="page-kicker">Owner account</span>
        <h1>Change password</h1>
        <p>Keep the key to Samwise private. Your session stays signed in after the change.</p>
    </div>

    <LumexCard Class="settings-card" Shadow="@Shadow.Medium" Radius="@Radius.Large">
        <LumexCardBody Class="settings-card-body">
        <EditForm Model="Input" method="post" OnValidSubmit="ChangePasswordAsync" FormName="change-owner-password">
            <DataAnnotationsValidator />
            <ValidationSummary class="auth-validation" role="alert" />

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="inline-alert @(Succeeded ? "inline-success" : null)" role="status">@Message</div>
            }

            <div class="auth-field">
                <label for="current-password">Current password</label>
                <InputText type="password" @bind-Value="Input.CurrentPassword" id="current-password" class="auth-input" autocomplete="current-password" placeholder="Current password" />
            </div>
            <div class="auth-field">
                <label for="new-password">New password</label>
                <InputText type="password" @bind-Value="Input.NewPassword" id="new-password" class="auth-input" autocomplete="new-password" placeholder="New password" />
            </div>
            <div class="auth-field">
                <label for="confirm-password">Confirm password</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirm-password" class="auth-input" autocomplete="new-password" placeholder="Confirm password" />
            </div>

            <LumexButton Type="@ButtonType.Submit" FullWidth="true" Color="@ThemeColor.Primary" Variant="@Variant.Shadow" Size="@Size.Large">Change password</LumexButton>
        </EditForm>
        </LumexCardBody>
    </LumexCard>
</div>
