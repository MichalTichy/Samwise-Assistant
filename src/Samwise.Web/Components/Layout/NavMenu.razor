<div class="sidebar-spacer"></div>

<AuthorizeView>
    <Authorized>
        <a class="user-entry" href="settings/password">
            <span class="avatar">@GetInitial(context.User.Identity?.Name)</span>
            <span class="user-name">@context.User.Identity?.Name</span>
        </a>
        <form action="logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <LumexButton Type="@ButtonType.Submit" Variant="@Variant.Light" Color="@ThemeColor.Default" Size="@Size.Small" FullWidth="true" Class="logout-button">Log out</LumexButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <a class="user-entry" href="login">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string GetInitial(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "S" : value.Trim()[0].ToString().ToUpperInvariant();
}
