@inherits AppComponentBase
@page "/configuration/inputs/todoist"
@attribute [Authorize]
@rendermode InteractiveServer
@using Samwise.Inputs.Todoist.Configuration

<PageTitle>Todoist inputs · Samwise</PageTitle>

<div class="page-heading-row">
    <div>
        <span class="page-kicker">Configuration · Inputs</span>
        <h1>Todoist</h1>
        <p>Tasks due soon become input for Samwise, so a plan is ready for approval before the deadline.</p>
    </div>
    <div class="heading-actions">
        <LumexButton Variant="@Variant.Flat" Color="@ThemeColor.Default" OnClick="LoadCatalogAsync" Disabled="@(loadingCatalog || !hasApiToken)">Test connection</LumexButton>
        <LumexButton Variant="@Variant.Flat" Color="@ThemeColor.Primary" OnClick="ProcessNowAsync" Disabled="@(processing || !hasApiToken)">
            @(processing ? "Processing…" : "Process now")
        </LumexButton>
        <LumexButton Color="@ThemeColor.Primary" Variant="@Variant.Shadow" OnClick="SaveAsync" Disabled="@(saving || IsLoading)">
            @(saving ? "Saving…" : "Save Todoist settings")
        </LumexButton>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(pageMessage))
{
    <div class="inline-alert teams-page-message @(pageMessageIsSuccess ? "inline-success" : null)">@pageMessage</div>
}

@if (LoadError is not null)
{
    <div class="inline-alert" role="alert">@LoadError</div>
}
else if (IsLoading)
{
    <LoadingSkeleton Label="Loading Todoist settings" Rows="6" />
}
else
{
<div class="teams-settings-grid">
    <LumexCard Class="email-settings-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
        <LumexCardBody Class="email-card-body">
            <div class="email-section-heading">
                <div>
                    <span class="email-section-icon" aria-hidden="true">↻</span>
                    <div>
                        <h2>Automatic processing</h2>
                        <p>Active tasks are checked continuously while Samwise is running and a token is saved.</p>
                    </div>
                </div>
                <span class="email-live-indicator"><i></i> Always on</span>
            </div>

            <label class="email-field compact-field">
                <span>Polling interval</span>
                <div class="email-input-with-suffix">
                    <input class="configuration-input" type="number" min="1" max="1440" @bind="pollingIntervalMinutes" />
                    <span>minutes</span>
                </div>
            </label>

            <label class="email-field compact-field">
                <span>Lead time</span>
                <div class="email-input-with-suffix">
                    <input class="configuration-input" type="number" min="0" max="720" @bind="leadHours" />
                    <span>hours</span>
                </div>
                <small>A task becomes input this long before it is due. All-day tasks are due at the start of their day.</small>
            </label>

            <label class="email-field compact-field">
                <span>Include overdue tasks</span>
                <div class="email-input-with-suffix">
                    <input class="configuration-input" type="number" min="0" max="365" @bind="overdueDays" />
                    <span>days back</span>
                </div>
                <small>Older overdue tasks are left alone, so connecting a long-neglected list does not flood the inbox.</small>
            </label>

            <label class="email-field">
                <span>Intake guidance</span>
                <textarea class="configuration-input email-guidance-input"
                          rows="5"
                          placeholder="Describe how Todoist tasks should be interpreted, e.g. which tasks Samwise should prepare or complete."
                          @bind="intakeGuidance"
                          @bind:event="oninput"></textarea>
                <small>This trusted guidance is captured with every new Todoist input.</small>
            </label>
        </LumexCardBody>
    </LumexCard>

    <LumexCard Class="email-settings-card teams-connection-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
        <LumexCardBody Class="email-card-body">
            <div class="email-section-heading">
                <div>
                    <span class="email-section-icon" aria-hidden="true">✓</span>
                    <div>
                        <h2>Todoist account</h2>
                        <p>Samwise reads tasks with a personal API token. It never changes Todoist itself; approved plans do that through the Todoist MCP tools.</p>
                    </div>
                </div>
            </div>

            <div class="email-account-form">
                <label class="email-field email-field-wide">
                    <span>API token</span>
                    <input class="configuration-input"
                           type="password"
                           autocomplete="new-password"
                           placeholder="@(hasApiToken ? "Saved — leave blank to keep it" : "Todoist → Settings → Integrations → Developer")"
                           @bind="apiToken"
                           @bind:event="oninput" />
                    <small>The token is protected before it is stored.</small>
                </label>
                @if (hasApiToken)
                {
                    <label class="configuration-toggle email-field-wide">
                        <input type="checkbox" @bind="removeApiToken" />
                        <span><strong>Remove saved API token</strong><small>Todoist processing stops until another token is saved.</small></span>
                    </label>
                }
            </div>

            @if (hasApiToken)
            {
                @if (loadingCatalog)
                {
                    <LoadingSkeleton Label="Loading projects and labels" Rows="3" />
                }
                else if (catalog is not null)
                {
                    <div class="microsoft-email-authorization">
                        <div>
                            <strong>Connected</strong>
                            <small>@(catalog.AccountName ?? "Todoist account")</small>
                        </div>
                    </div>
                    <dl class="teams-catalog-summary">
                        <div><dt>Projects</dt><dd>@catalog.Projects.Count</dd></div>
                        <div><dt>Labels</dt><dd>@catalog.Labels.Count</dd></div>
                    </dl>
                }
            }

            @if (!string.IsNullOrWhiteSpace(lastError))
            {
                <div class="inline-alert">@lastError</div>
            }

            <div class="email-card-actions">
                <span class="save-state">@FormatLastCheck(lastSuccessfulCheckAt)</span>
            </div>
        </LumexCardBody>
    </LumexCard>
</div>

<section class="teams-ignore-section">
    <div class="email-accounts-heading">
        <div>
            <h2>Ignored Todoist tasks</h2>
            <p>Tasks in ignored projects or with an ignored label are recorded, but are not sent to AI.</p>
        </div>
    </div>

    <div class="todoist-ignore-grid">
        <LumexCard Class="email-settings-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
            <LumexCardBody Class="email-card-body">
                <div class="teams-ignore-heading"><span>01</span><div><h3>Projects</h3><p>Ignore every task in selected projects.</p></div></div>
                @RenderToggleList(ProjectOptions, ignoredProjects, "No projects loaded yet.")
            </LumexCardBody>
        </LumexCard>
        <LumexCard Class="email-settings-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
            <LumexCardBody Class="email-card-body">
                <div class="teams-ignore-heading"><span>02</span><div><h3>Labels</h3><p>Ignore tasks carrying any selected label.</p></div></div>
                @RenderToggleList(LabelOptions, ignoredLabels, "No labels loaded yet.")
            </LumexCardBody>
        </LumexCard>
    </div>
</section>
}

@code {
    private RenderFragment RenderToggleList(
        IReadOnlyList<TodoistInputSource> options,
        List<TodoistInputSource> selected,
        string emptyText) => __builder =>
    {
        if (options.Count == 0)
        {
            <div class="empty-inline teams-source-empty">@emptyText</div>
        }
        else
        {
            <div class="todoist-toggle-list">
                @foreach (var option in options)
                {
                    var isSelected = IsSelected(selected, option.Id);
                    <button type="button"
                            class="@(isSelected ? "is-selected" : null)"
                            aria-pressed="@isSelected"
                            @onclick="() => Toggle(selected, option)">
                        @option.DisplayName
                    </button>
                }
            </div>
        }
    };
}
