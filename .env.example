# Container image and published HTTP port
SAMWISE_IMAGE=registry.tichymichal.net/samwise-assistant:latest
SAMWISE_PORT=8080
SAMWISE_ALLOWED_HOSTS=*
# Keep false only when Samwise is accessed over plain HTTP on a trusted network.
# Set true when HTTPS is terminated by a reverse proxy.
SAMWISE_REQUIRE_HTTPS=false

# Existing PostgreSQL instance. Separate databases for Samwise and Gateway are
# recommended. Use host.docker.internal when PostgreSQL runs on the Docker host.
SAMWISE_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=samwise;Username=samwise;Password=replace-me
CODEX_GATEWAY_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=codex_gateway;Username=codex_gateway;Password=replace-me

# The initial password is only used when the database has no owner yet.
# After signing in and changing the password, this value can be removed.
SAMWISE_OWNER_EMAIL=owner@example.com
SAMWISE_OWNER_INITIAL_PASSWORD=replace-with-a-long-initial-password
# Authenticates Gateway calls to Samwise's own MCP endpoint.
SAMWISE_MCP_API_KEY=replace-with-a-long-random-api-key
# Write-only key used by mobile Shortcuts to submit manual inputs.
SAMWISE_MANUAL_INPUT_API_KEY=replace-with-a-different-long-random-api-key

# Microsoft 365 IMAP OAuth. Register a public-client Entra application with
# delegated Office 365 Exchange Online IMAP.AccessAsUser.All permission and
# enable public client flows. Use organizations for accounts from any work tenant.
SAMWISE_MICROSOFT365_CLIENT_ID=replace-with-entra-application-client-id
SAMWISE_MICROSOFT365_TENANT_ID=organizations
# Optional VAPID contact for push notifications (mailto: or https:). Defaults to mailto:SAMWISE_OWNER_EMAIL.
SAMWISE_WEB_PUSH_SUBJECT=

# Codex CLI API Gateway images and admin UI
CODEX_GATEWAY_IMAGE=registry.tichymichal.net/codex-gateway:latest
CODEX_GATEWAY_RUNNER_IMAGE=registry.tichymichal.net/codex-gateway-runner:latest
CODEX_GATEWAY_BIND_ADDRESS=0.0.0.0
CODEX_GATEWAY_PORT=5050
CODEX_GATEWAY_ADMIN_USERNAME=admin
CODEX_GATEWAY_ADMIN_PASSWORD=replace-with-a-long-password
CODEX_GATEWAY_DATA_VOLUME=codex-gateway-data
CODEX_GATEWAY_AUTH_VOLUME=codex-gateway-auth
CODEX_GATEWAY_RUNNER_NETWORK=codex-gateway-runner
CODEX_GATEWAY_BACKEND_NETWORK=codex-gateway-backend
DOCKER_GID=0

# Mail, calendar, and contacts MCP on the trusted private network. The admin
# token protects its configuration UI; Gateway project grants protect tool use.
MAIL_CALENDAR_CONTACTS_IMAGE=registry.tichymichal.net/mcp-mail-calendar-contacts:latest
MAIL_CALENDAR_CONTACTS_PORT=5051
MAIL_CALENDAR_CONTACTS_BIND_ADDRESS=0.0.0.0
MAIL_CALENDAR_CONTACTS_MCP_EXTERNAL_URL=http://localhost:5051
MAIL_CALENDAR_CONTACTS_MCP_ADMIN_TOKEN=replace-with-a-long-random-admin-token
MAIL_CALENDAR_CONTACTS_DATA_VOLUME=mcp-mail-calendar-contacts-data

# Official Todoist MCP. It is reachable only from the private Gateway network.
# Get the API token from Todoist Settings -> Integrations -> Developer.
TODOIST_MCP_RUNTIME_IMAGE=node:latest
TODOIST_API_KEY=replace-with-your-todoist-api-token

# Riganti IS MCP: private Gateway network only, no published host port.
RIGANTI_IS_MCP_IMAGE=registry.tichymichal.net/mcp-riganti-is:latest
RIGANTI_IS_BEARER_TOKEN=replace-with-riganti-is-bearer-token

# Toggl MCP: private Gateway network only, no published host port. Classic
# Toggl Track needs the workspace ID; Toggl Focus also needs organization ID.
TOGGL_MCP_IMAGE=registry.tichymichal.net/mcp-toggl-track:latest
TOGGL_TRACK_API_KEY=replace-with-toggl-api-token-or-focus-key
TOGGL_TRACK_ORGANIZATION_ID=
TOGGL_TRACK_WORKSPACE_ID=replace-with-workspace-id
TOGGL_TRACK_API_MODE=auto
TOGGL_TRACK_BASE_URL=

# Official Wallet by BudgetBakers MCP. Generate an MCP access token in Wallet
# Settings -> MCP. Gateway adds the Bearer prefix when connecting upstream.
WALLET_MCP_ACCESS_TOKEN=replace-with-wallet-mcp-access-token

# Microsoft Teams MCP. The container is reachable by the Gateway at
# http://teams-mcp:8080 and has a private-network admin UI on port 5052.
TEAMS_MCP_IMAGE=registry.tichymichal.net/mcp-teams:latest
TEAMS_MCP_BIND_ADDRESS=0.0.0.0
TEAMS_MCP_PORT=5052
TEAMS_MCP_TENANT_ID=replace-with-entra-tenant-id
TEAMS_MCP_CLIENT_ID=replace-with-entra-application-client-id
TEAMS_MCP_CLIENT_SECRET=replace-with-client-secret
TEAMS_MCP_ADMIN_PASSWORD=replace-with-a-long-random-password
TEAMS_MCP_DATA_VOLUME=mcp-teams-data

# Samwise talks to the Gateway over the private Compose network. Keep the
# trailing /v1/ segment if overriding these URLs.
SAMWISE_INTAKE_BASE_URL=http://gateway:8080/v1/
SAMWISE_INTAKE_API_KEY=replace-with-the-intake-key
SAMWISE_PLANNING_BASE_URL=http://gateway:8080/p/samwise-planning/v1/
SAMWISE_PLANNING_API_KEY=replace-with-the-planning-key
SAMWISE_EXECUTION_BASE_URL=http://gateway:8080/p/samwise-execution/v1/
SAMWISE_EXECUTION_API_KEY=replace-with-the-execution-key
SAMWISE_AUTO_APPROVAL_BASE_URL=http://gateway:8080/p/samwise-auto-approval/v1/
SAMWISE_AUTO_APPROVAL_API_KEY=
SAMWISE_AUTO_EXECUTION_BASE_URL=http://gateway:8080/p/samwise-auto-execution/v1/
SAMWISE_AUTO_EXECUTION_API_KEY=
