@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <header class="app-header">
            <div>
                <span class="eyebrow">Personal assistant</span>
                <strong>Samwise</strong>
            </div>
            <AuthorizeView>
                <Authorized>
                    <a class="account-link" href="Account/Manage">@context.User.Identity?.Name</a>
                </Authorized>
            </AuthorizeView>
        </header>

        <article class="app-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Samwise hit an unexpected problem.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
