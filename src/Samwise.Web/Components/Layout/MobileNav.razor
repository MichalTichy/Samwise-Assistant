@* Phone navigation: a compact top bar, a bottom tab bar, and a "More" sheet. The sheet uses the
   native popover API, so it works without an interactive circuit and closes on navigation. *@

<header class="mobile-topbar">
    <a class="mobile-brand" href="board">
        <span class="mobile-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="M25.6 6.9C16.8 7 10.7 11.5 8.9 20.1c4.6-5.4 8.8-7.7 13.7-8.6-5.4 2.4-9.2 5.6-11.3 10.1 4.9.7 8.8-.5 11.6-3.7 2.5-2.9 3.3-6.7 2.7-11Z" /><path d="M8.4 20.7c-1.3 1.2-2.1 2.8-2.5 4.6" /></svg>
        </span>
        <strong>Samwise</strong>
    </a>
</header>

<nav class="mobile-tabbar" aria-label="Primary">
    <NavLink class="mobile-tab" href="" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        <span>New</span>
    </NavLink>
    <NavLink class="mobile-tab" href="board">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" /><rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" /></svg>
        <span>Board</span>
    </NavLink>
    <NavLink class="mobile-tab" href="inbox">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13H7l-3 3V4Z" /><path d="M8 9h8M8 13h5" /></svg>
        <span>Inbox</span>
    </NavLink>
    <button type="button" class="mobile-tab" popovertarget="mobile-more-sheet">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.4" /><circle cx="12" cy="12" r="1.4" /><circle cx="19" cy="12" r="1.4" /></svg>
        <span>More</span>
    </button>
</nav>

<div id="mobile-more-sheet" class="mobile-sheet" popover>
    <div class="mobile-sheet-handle" aria-hidden="true"></div>
    <div class="mobile-sheet-heading">
        <strong>More</strong>
        <button type="button" class="mobile-sheet-close" popovertarget="mobile-more-sheet" popovertargetaction="hide" aria-label="Close">×</button>
    </div>

    <span class="mobile-sheet-label">Inputs</span>
    <NavLink class="mobile-sheet-link" href="configuration/inputs/emails">Emails</NavLink>
    <NavLink class="mobile-sheet-link" href="configuration/inputs/teams">Microsoft Teams</NavLink>

    <span class="mobile-sheet-label">Work Items</span>
    <NavLink class="mobile-sheet-link" href="tasks">@Samwise.Web.Resources.TaskResources.Tasks</NavLink>
    <NavLink class="mobile-sheet-link" href="work-items/discarded">Discarded</NavLink>

    <span class="mobile-sheet-label">Configuration</span>
    <NavLink class="mobile-sheet-link" href="agent-settings">Agent settings</NavLink>
    <NavLink class="mobile-sheet-link" href="playbooks">Playbooks</NavLink>
    <NavLink class="mobile-sheet-link" href="settings/notifications">Notifications</NavLink>

    <span class="mobile-sheet-label">Account</span>
    <AuthorizeView>
        <Authorized>
            <NavLink class="mobile-sheet-link" href="settings/password">Change password</NavLink>
            <form action="logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="mobile-sheet-link mobile-sheet-logout">Log out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="mobile-sheet-link" href="login">Log in</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>
