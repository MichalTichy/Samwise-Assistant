@page "/board"
@attribute [Authorize]
@rendermode InteractiveServer
@using WorkItemStatus = Samwise.Domain.WorkItems.WorkItemStatus

<PageTitle>Board · Samwise</PageTitle>

<div class="board-page">
<div class="page-heading-row">
    <div>
        <span class="page-kicker">Work items</span>
        <h1>Board</h1>
        <p>Every card represents an actionable work item and its current approval state.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="button-link button-link-secondary board-action" @onclick="LoadAsync" disabled="@loading" title="The board also refreshes automatically every 10 seconds">Refresh</button>
        <a class="button-link button-link-secondary board-action" href="/work-items/discarded">Discarded</a>
        <a class="button-link button-link-secondary board-action" href="/work-items/auto-executions">Auto report</a>
        <a class="button-link button-link-primary board-new-input" href="/">New input</a>
    </div>
</div>

@if (loading && workItems.Count == 0)
{
    <LoadingSkeleton Label="Loading work items" Rows="5" />
}

else
{
    var activeColumn = ActiveColumnKey;
    <div class="board-tabs" role="tablist" aria-label="Board columns">
        @foreach (var column in MobileColumns)
        {
            var isActive = column.Key == activeColumn;
            <button type="button"
                    role="tab"
                    class="board-tab @(isActive ? "is-active" : null)"
                    aria-selected="@isActive"
                    @onclick="() => SelectColumn(column.Key)">
                <span class="column-dot @column.CssClass"></span>
                <span>@column.Name</span>
                <span class="column-count">@CardsFor(column).Count</span>
            </button>
        }
    </div>

    <div class="work-item-board">
        @foreach (var column in Columns)
        {
            var cards = CardsFor(column);
            <section class="board-column" data-active="@(column.Key == activeColumn ? "true" : "false")">
                <header>
                    <span class="column-dot @column.CssClass"></span>
                    <h2>@column.Name</h2>
                    <span class="column-count">@cards.Count</span>
                </header>

                <div class="column-cards">
                    @foreach (var workItem in cards)
                    {
                        <a class="work-item-card-link" href="work-items/@workItem.Id">
                        <LumexCard Class="work-item-card" Shadow="@Shadow.Small" Radius="@Radius.Large">
                            <LumexCardBody Class="work-item-card-body">
                            <div class="work-item-card-topline">
                                <div class="work-item-card-badges">
                                    <LumexChip Size="@Size.Small" Variant="@ChipVariant.Flat" Color="@ThemeColor.Default" Class="@($"status-chip status-{workItem.Status.ToString().ToLowerInvariant()}")">@FormatStatus(workItem.Status)</LumexChip>
                                    @if (workItem.AutomaticallyExecuted)
                                    {
                                        <LumexChip Size="@Size.Small" Variant="@ChipVariant.Flat" Color="@ThemeColor.Success" Class="auto-execution-chip">Auto-approved</LumexChip>
                                    }
                                </div>
                                <span class="revision-label">r@(workItem.Revision)</span>
                            </div>
                            <h3>@workItem.Title</h3>
                            <p>@(workItem.Status == WorkItemStatus.AwaitingUserInput && workItem.UserQuestion is not null
                                ? workItem.UserQuestion
                                : workItem.Description)</p>
                            <footer>
                                <span>@(workItem.Status == WorkItemStatus.AwaitingUserInput
                                    ? "Answer needed"
                                    : workItem.PlanNumber is null ? "Plan pending" : $"Plan {workItem.PlanNumber}")</span>
                                <time>@workItem.UpdatedAt.ToLocalTime().ToString("d MMM, HH:mm")</time>
                            </footer>
                            </LumexCardBody>
                        </LumexCard>
                        </a>
                    }

                    @if (cards.Count == 0)
                    {
                        <div class="empty-column">No work items here</div>
                    }
                </div>
            </section>
        }
    </div>
}

</div>
